GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq chat model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-20b

# Cross-encoder reranker (default: cross-encoder/ms-marco-MiniLM-L-6-v2)
# RERANK_MODEL=BAAI/bge-reranker-base
# RERANK_POOL=20

# LangSmith tracing (create a key at https://smith.langchain.com)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=multi-source-rag
# LANGSMITH_TRACING=true

# RAGAS judge model (defaults to GROQ_MODEL)
# RAGAS_JUDGE_MODEL=openai/gpt-oss-120b
# Judge retries; set 0 to fail fast when free-tier quota is exhausted.
# RAGAS_JUDGE_RETRIES=4

# Persistent conversation memory
# MEMORY_DB_PATH=memory.sqlite3

# Sidebar sessions and rendered transcripts (SQLite)
# SESSIONS_DB_PATH=sessions.sqlite3
# LEGACY_SESSIONS_JSON=chat_sessions.json

# Explicit LLM retry/backoff and pacing (seconds)
# LLM_RETRY_ATTEMPTS=4
# LLM_RETRY_BASE_DELAY=1.0
# LLM_RETRY_MAX_DELAY=30
# LLM_RETRY_JITTER=0.3
# LLM_TIMEOUT_S=60
# LLM_MIN_INTERVAL_S=0

# Retrieval attempts (not LLM retries)
# MAX_ATTEMPTS=2

# Multi-query/query decomposition
# MULTI_QUERY_COUNT=3

# Parent-window context expansion
# PARENT_DOCUMENT_RETRIEVAL=true
# PARENT_WINDOW=2

# Guardrail limits
# MAX_QUESTION_CHARS=4000
# MAX_CONTEXT_CHARS_PER_DOC=6000

# USD cost estimates. Override per-model rates as JSON if Groq changes prices.
# MODEL_PRICING_JSON={"openai/gpt-oss-120b":{"input":0.15,"output":0.60}}

# Website ingestion limits
# MAX_WEBSITE_BYTES=5000000
# MAX_WEBSITE_CHARS=400000
